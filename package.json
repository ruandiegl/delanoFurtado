{
  "name": "delano-furtado-web",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.21.1",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && npm run build:client && npm run build:server && npm run prerender",
    "build:ftp": "npm run build && npm run verify:build && node scripts/package-ftp.mjs",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "assets:prepare": "node scripts/prepare-assets.mjs",
    "assets:favicons": "node scripts/prepare-favicons.mjs",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir .prerender",
    "prerender": "node scripts/prerender.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "verify:preview": "node scripts/verify-preview.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/manrope": "^5.2.0",
    "@gsap/react": "2.1.2",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "gsap": "3.15.0",
    "lucide-react": "1.47.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "6.30.6",
    "styled-components": "6.4.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "0.2.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "babel-plugin-styled-components": "^2.1.4",
    "eslint": "10.4.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.6.0",
    "jsdom": "29.1.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
