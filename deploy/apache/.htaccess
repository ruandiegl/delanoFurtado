# Delano Furtado — HostGator/cPanel, installed at the domain document root.
# Merge provider-specific PHP/AutoSSL settings before replacing a remote file.
Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On

# Preserve cPanel certificate validation files already managed by the provider.
RewriteRule ^\.well-known/(acme-challenge|pki-validation)/ - [END]

# Fixed canonical host; query strings are retained by mod_rewrite.
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\.delanofurtado\.adv\.br$ [NC]
RewriteRule ^ https://www.delanofurtado.adv.br%{REQUEST_URI} [R=308,END,NE]

# Only external document requests redirect: internal rewrites cannot loop.
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
RewriteRule ^index\.html$ / [R=308,END,NC]

RewriteCond %{THE_REQUEST} \s/+localizacao(?:/index)?\.html(?:[?\s]) [NC]
RewriteRule ^localizacao(?:/index)?\.html$ /localizacao [R=308,END,NC]

RewriteCond %{THE_REQUEST} \s/+contate-nos(?:/index)?\.html(?:[?\s]) [NC]
RewriteRule ^contate-nos(?:/index)?\.html$ /contate-nos [R=308,END,NC]

# Resolve known pages before mod_dir can add a trailing-slash redirect.
RewriteRule ^localizacao/?$ localizacao/index.html [END,NC]
RewriteRule ^contate-nos/?$ contate-nos/index.html [END,NC]

# Temporary compatibility only when the old gallery remains on the server.
# The FTP package does not ship or create this legacy page or its bundles.
RewriteCond %{DOCUMENT_ROOT}/galeria.html -f
RewriteRule ^galeria/?$ galeria.html [END,NC]

# Real files stay real files. Unknown paths use ErrorDocument with status 404.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [END]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Cache-Control "public, max-age=0, must-revalidate"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
